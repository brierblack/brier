# ============================================================
# Brier 环境变量配置
#
# 用法：复制此文件为 .env 并填写实际值
# cp .env.example .env
# ============================================================

# ---- 服务配置 ----
HOST=0.0.0.0
PORT=8090

# ---- 数据库配置 ----
# Docker 环境中由 docker-compose 自动设置，本地开发需手动配置
DATABASE_URL=postgresql://brier:brier@localhost:5433/brier

# ---- JWT 密钥 ----
# 用于签发和验证登录会话 Token，请使用足够长的随机字符串
JWT_SECRET=dev-secret-change-in-production

# ---- OAuth 提供方配置 ----
# 每个厂商一组 {PREFIX}_CLIENT_ID / _CLIENT_SECRET / _REDIRECT_URI
# github 必填；gitee/gitlab 等可选（三变量齐全才注册）
# 在 https://github.com/settings/developers 创建 OAuth App 获取
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 回调地址必须与 GitHub OAuth App 中配置的一致
# 生产环境（后端直接托管前端）: http://localhost:8090/api/auth/github/callback
# 开发环境（Vite dev server 代理）: http://localhost:5173/api/auth/github/callback
GITHUB_REDIRECT_URI=http://localhost:8090/api/auth/github/callback

# GITEE_CLIENT_ID=
# GITEE_CLIENT_SECRET=
# GITEE_REDIRECT_URI=https://<host>/api/auth/gitee/callback

# GITLAB_CLIENT_ID=
# GITLAB_CLIENT_SECRET=
# GITLAB_REDIRECT_URI=https://<host>/api/auth/gitlab/callback

# ---- 会话 Cookie 安全 ----
# 生产（HTTPS 部署）置 true；本地 http 开发保持 false/留空
COOKIE_SECURE=false

# ---- 前端静态文件目录 ----
# 本地开发时指向 Vite 构建产物，Docker 环境中为 /app/frontend/dist
FRONTEND_DIR=apps/web/dist

# ---- 前端地址（可选）----
# 开发模式下设为 Vite dev server 地址，生产环境留空
# 开发模式需同时将 GITHUB_REDIRECT_URI 改为 http://localhost:5173/api/auth/github/callback
# FRONTEND_URL=http://localhost:5173
