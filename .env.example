# ============================================================
# Hive 环境变量配置
#
# 用法：复制此文件为 .env 并填写实际值
# cp .env.example .env
# ============================================================

# ---- 服务配置 ----
HOST=0.0.0.0
PORT=8090

# ---- JWT 密钥 ----
# 用于签发和验证登录会话 Token，请使用足够长的随机字符串
JWT_SECRET=dev-secret-change-in-production

# ---- GitHub OAuth 配置 ----
# 在 https://github.com/settings/developers 创建 OAuth App 获取
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 回调地址必须与 GitHub OAuth App 中配置的一致
# 生产环境（后端直接托管前端）: http://localhost:8090/api/auth/github/callback
# 开发环境（Vite dev server 代理）: http://localhost:5173/api/auth/github/callback
GITHUB_REDIRECT_URI=http://localhost:8090/api/auth/github/callback

# ---- 前端静态文件目录 ----
# 本地开发时指向 Vite 构建产物，Docker 环境中为 /app/frontend/dist
FRONTEND_DIR=apps/web/dist

# ---- 前端地址（可选）----
# 开发模式下设为 Vite dev server 地址，生产环境留空
# 开发模式需同时将 GITHUB_REDIRECT_URI 改为 http://localhost:5173/api/auth/github/callback
# FRONTEND_URL=http://localhost:5173
