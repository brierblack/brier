# ============================================================
# Hive 环境变量配置
#
# 用法：复制此文件为 .env 并填写实际值
# cp .env.example .env
# ============================================================

# ---- Web 服务端口 ----
WEB_PORT=8090

# ---- GitHub OAuth 配置 ----
# 后端接入后使用，当前前端使用 mock 数据
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8090/auth/github/callback
