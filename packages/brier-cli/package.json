{
  "name": "@brierb/brier-cli",
  "version": "0.0.14",
  "description": "Brier 平台接入命令行工具：通过加密隧道将本机接入 Brier 远程编码池，接收并执行远程任务",
  "keywords": [
    "brier",
    "cli",
    "tunnel",
    "agent"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "brier": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./types/index.d.ts"
    },
    "./tunnel": {
      "import": "./dist/tunnel/index.js",
      "types": "./types/tunnel/index.d.ts"
    }
  },
  "files": [
    "dist",
    "types"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "pnpm run build",
    "release:patch": "npm version patch --no-git-tag-version && npm publish --access public",
    "release:minor": "npm version minor --no-git-tag-version && npm publish --access public",
    "release:major": "npm version major --no-git-tag-version && npm publish --access public"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "node-pty": "^1.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ws": "^8.5.13",
    "typescript": "^6.0.3"
  }
}
