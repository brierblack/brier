{
  "name": "@brierb/brier-cli",
  "version": "0.0.1",
  "type": "module",
  "bin": {
    "brier": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./types/index.d.ts"
    },
    "./tunnel": {
      "import": "./dist/tunnel/TunnelClient.js",
      "types": "./types/tunnel/TunnelClient.d.ts"
    }
  },
  "files": [
    "dist",
    "types"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ws": "^8.5.13",
    "typescript": "^6.0.3"
  }
}
