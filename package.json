{
  "name": "brier",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @brierb/web dev",
    "build": "pnpm --filter @brierb/ui build && pnpm --filter @brierb/cli build && pnpm --filter @brierb/web build",
    "preview": "pnpm --filter @brierb/web preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
